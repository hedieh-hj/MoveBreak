<Window x:Class="MoveBreak.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:MoveBreak.Views" Title="MoveBreak" Width="1050" Height="700" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI">
 <Window.Resources>
  <local:HeightConverter x:Key="HeightConverter"/><local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="8"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" Opacity=".08" ShadowDepth="2"/></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#4F8F86"/><Setter Property="Foreground" Value="White"/></Style>
 </Window.Resources>
 <Grid>
  <TabControl Margin="18" Background="Transparent" BorderThickness="0">
   <TabItem Header="خانه">
    <ScrollViewer><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <Border Style="{StaticResource Card}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="تا استراحت بعدی" Foreground="{DynamicResource MutedBrush}" FontSize="18"/><TextBlock Text="{Binding Countdown}" FontSize="76" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Foreground="#4F8F86" FontSize="16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button Style="{StaticResource Primary}" Command="{Binding TogglePauseCommand}" Content="توقف / ادامه"/><Button Command="{Binding RestartCommand}" Content="شروع مجدد"/><Button Command="{Binding SkipCommand}" Content="رد کردن"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="هفت روز اخیر" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding WeekValues}" Margin="0,16,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel VerticalAlignment="Bottom" Margin="5"><Border Background="#8CC8BD" CornerRadius="6" Height="{Binding Converter={StaticResource HeightConverter}}" MinHeight="5"/><TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,5"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="تمرین پیشنهادی بعدی" FontSize="16" Foreground="{DynamicResource MutedBrush}"/><Image Source="{Binding CurrentExercise.ImagePath}" Height="190" Stretch="UniformToFill" Margin="0,12"/><TextBlock Text="{Binding CurrentExercise.Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentExercise.Instructions}" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource MutedBrush}"/><TextBlock Margin="0,4"><Run Text="مدت حرکت: "/><Run Text="{Binding CurrentExercise.DurationSeconds}" FontWeight="Bold"/><Run Text=" ثانیه"/></TextBlock></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="امروز" FontSize="18" FontWeight="SemiBold"/><TextBlock><Run Text="استراحت‌های انجام‌شده: "/><Run Text="{Binding CompletedToday}" FontWeight="Bold"/></TextBlock><TextBlock><Run Text="زمان نشستن این نوبت: "/><Run Text="{Binding SittingMinutesToday}" FontWeight="Bold"/><Run Text=" دقیقه"/></TextBlock></StackPanel></Border>
     </StackPanel>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="تمرین‌ها"><ScrollViewer><ItemsControl ItemsSource="{Binding Exercises}" Margin="10"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding ImagePath}" Height="110" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Margin="0,8"/><TextBlock><Run Text="مدت: "/><Run Text="{Binding DurationSeconds}"/><Run Text=" ثانیه"/></TextBlock></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
   <TabItem Header="تنظیمات"><Border Style="{StaticResource Card}" Width="520" VerticalAlignment="Top" Margin="20"><StackPanel><TextBlock Text="تنظیمات زمان‌بندی" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="فاصله یادآوری (دقیقه)" Margin="0,22,0,5"/><TextBox Text="{Binding ReminderMinutes}" Padding="10"/><TextBlock Text="مدت استراحت (دقیقه)" Margin="0,14,0,5"/><TextBox Text="{Binding BreakMinutes}" Padding="10"/><CheckBox IsChecked="{Binding EyeRuleEnabled}" Content="فعال‌بودن قانون ۲۰-۲۰-۲۰" Margin="0,18,0,5"/><CheckBox IsChecked="{Binding SoundEnabled}" Content="پخش صدا" Margin="0,5"/><CheckBox IsChecked="{Binding StartWithWindows}" Content="اجرا با شروع ویندوز" Margin="0,5"/><CheckBox IsChecked="{Binding DarkMode}" Content="حالت تاریک" Margin="0,5"/><Button Style="{StaticResource Primary}" Command="{Binding SaveSettingsCommand}" Content="ذخیره تنظیمات" Margin="0,22,0,0"/></StackPanel></Border></TabItem>
  </TabControl>
  <Border Visibility="{Binding IsBreakVisible, Converter={StaticResource BoolToVisibility}}" Background="#DD1D2927" Panel.ZIndex="10"><Border Background="{DynamicResource Surface}" CornerRadius="24" Padding="28" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="وقت حرکت است" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/><Image Source="{Binding CurrentExercise.ImagePath}" Height="260" Stretch="Uniform" Margin="0,15"/><TextBlock Text="{Binding CurrentExercise.Title}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding CurrentExercise.Instructions}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10"/><TextBlock HorizontalAlignment="Center" Margin="0,0,0,8"><Run Text="مدت پیشنهادی: "/><Run Text="{Binding CurrentExercise.DurationSeconds}" FontWeight="Bold"/><Run Text=" ثانیه"/></TextBlock><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource Primary}" Command="{Binding CompleteCommand}" Content="انجام شد"/><Button Command="{Binding SnoozeCommand}" Content="۵ دقیقه بعد"/><Button Command="{Binding SkipCommand}" Content="رد کردن"/></StackPanel></StackPanel></Border></Border>
 </Grid>
</Window>
