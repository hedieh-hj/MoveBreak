<Application x:Class="MoveBreak.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="Accent" Color="#4F8F86"/>
      <SolidColorBrush x:Key="AccentSelectionBrush" Color="#3D766E"/>
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#3F776F"/>
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F7F6"/>
      <SolidColorBrush x:Key="ForegroundBrush" Color="#263A37"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#60706D"/>
      <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#E9EFED"/>
      <SolidColorBrush x:Key="ControlHoverBrush" Color="#DDE8E5"/>
      <SolidColorBrush x:Key="ControlBorderBrush" Color="#D4DEDB"/>
      <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#91A09C"/>
      <SolidColorBrush x:Key="FocusBrush" Color="#4F8F86"/>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/ControlStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
